# Placeholder values only. Store real values outside Git and restrict file access.
CHAT_WEB_API_URL=https://www.wildheartsai.com/api/chat/worker/v1
# Same credential hashed by the trusted operator provisioning script. Coordinator only.
CHAT_COORDINATOR_TOKEN=REPLACE_WITH_COORDINATOR_CREDENTIAL
CHAT_WORKER_ID=chat-vps-1
CHAT_INFERENCE_URL=http://PRIVATE_MODEL_HOST:8081/v1
CHAT_INFERENCE_MODEL=REPLACE_WITH_CONFIGURED_MODEL_ID
CHAT_INFERENCE_MAX_TOKENS=2048
CHAT_INFERENCE_API_KEY=
IGGY_URL=http://wildhearts-iggy:8417
IGGY_BEARER_TOKEN=REPLACE_WITH_IGGY_TOKEN_FILE_CONTENT

# Optional offline research. Use docker-compose.research.yml to mount the curated
# publication parent read-only into chat-gateway and raw source read-only into the
# isolated publisher. These values belong in a protected, untracked env file.
CHAT_RESEARCH_CORPUS_HOST_PATH=/srv/wildhearts/health-research-published
CHAT_RESEARCH_SOURCE_PATH=/srv/private/health-research-wiki
CHAT_RESEARCH_GATEWAY_TOKEN=REPLACE_WITH_43_CHAR_BASE64URL_SECRET
