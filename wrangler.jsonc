// The web Worker: the Next app on Cloudflare (OpenNext), and the only public entry point.
// `/api/*` goes to the API Worker (api/wrangler.jsonc) over the API service binding. No secrets
// and no database here: pages reach data only through the API (src/lib/backend/api.ts).
// Plan: docs/superpowers/plans/2026-10-30-cloudflare-migration.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wildhearts-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Local development: `npm run cf:preview` runs this Worker and the API Worker together.
  "vars": { "WILDHEARTS_BACKEND": "api", "DEMO_ENABLED": "1" },
  "services": [{ "binding": "API", "service": "wildhearts-api" }],

  "env": {
    "preview": {
      "name": "wildhearts-web-preview",
      "vars": { "WILDHEARTS_BACKEND": "api" },
      "services": [{ "binding": "API", "service": "wildhearts-api-preview" }]
    },
    "production": {
      "name": "wildhearts-web-production",
      "vars": { "WILDHEARTS_BACKEND": "api" },
      "services": [{ "binding": "API", "service": "wildhearts-api-production" }]
    }
  }
}
