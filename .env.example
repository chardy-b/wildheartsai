# Local settings for both `npm run dev` (Next.js) and `npm run preview` (Wrangler): copy to
# .env.local. Deployed Workers get the same names as vars and secrets instead (see README).
# Never commit real credentials or tokens.

# Public canonical URL for metadata previews. Inlined at build time, so set it where you build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The database is Cloudflare D1 (binding DB in wrangler.jsonc). Locally it lives in
# .wrangler/state; create its tables with `npm run db:migrate:local`.

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
SIGNUPS_ENABLED=true
# Early access: when set, sign-up also asks for this invite code. Leave blank for open sign-up.
SIGNUP_INVITE_CODE=

# Email (verification and reset links only; never health information), sent with Cloudflare
# Email Service (binding EMAIL). `npm run dev` prints emails to the console instead.
EMAIL_FROM=Wild Hearts Health <no-reply@wildheartsai.com>

# Epic SMART on FHIR.
# EPIC_ENVIRONMENT=sandbox offers only Epic's sandbox. production offers real health systems
# plus the sandbox as sample data, and needs the EPIC_PRODUCTION_* settings below. Production
# access also stays fail-closed until its separate readiness switch is explicitly enabled.
EPIC_ENVIRONMENT=sandbox
EPIC_PRODUCTION_ACCESS_ENABLED=false
# Non-production client (Epic's sandbox); its public key is served at /api/epic/jwks
EPIC_CLIENT_ID=replace-with-epic-non-production-client-id
EPIC_REDIRECT_URI=http://localhost:3000/api/epic/callback
# Private RSA JWK from `npm run epic:key` (one line of JSON)
EPIC_PRIVATE_JWK=
# During key rotation only: the previous public JWK, still served at /api/epic/jwks
EPIC_RETIRING_PUBLIC_JWK=
# Production client (real health systems); its public key is served at /api/epic/jwks/production.
# Use a separate key from `npm run epic:key`. Not needed locally.
EPIC_PRODUCTION_CLIENT_ID=
EPIC_PRODUCTION_PRIVATE_JWK=
EPIC_PRODUCTION_RETIRING_PUBLIC_JWK=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Key-encryption key for stored health records; generate it the same way, and never reuse TOKEN_ENCRYPTION_KEY.
RECORDS_ENCRYPTION_KEY=

# Record imports run on Cloudflare Workflows (binding SYNC_WORKFLOW); nothing to configure.
# `npm run dev` runs them in-process instead. Workflows only ever receive internal IDs.
