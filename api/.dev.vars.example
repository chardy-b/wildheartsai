# Local secrets for `wrangler dev` (copy to .dev.vars, which is git-ignored). Made-up values only.
# The same names as the Next app's .env.local, minus DATABASE_URL and R2_* (bindings replace them).
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM=Wild Hearts Health <no-reply@wildheartsai.com>
SIGNUPS_ENABLED=true
SIGNUP_INVITE_CODE=
EPIC_ENVIRONMENT=sandbox
EPIC_EXPANDED_SCOPES=false
EPIC_PRODUCTION_ACCESS_ENABLED=false
EPIC_CLIENT_ID=replace-with-epic-non-production-client-id
EPIC_REDIRECT_URI=http://localhost:3000/api/epic/callback
EPIC_PRIVATE_JWK=
# 32 random bytes, base64 each; never the same value twice.
TOKEN_ENCRYPTION_KEY=
RECORDS_ENCRYPTION_KEY=
METRIPORT_API_KEY=
