// The API Worker. Reachable only through the web Worker's service binding (no public URL).
// Plan: docs/superpowers/plans/2026-10-30-cloudflare-migration.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wildhearts-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Modules shared with the Next app mark themselves server-only; everything here is server code.
  "alias": { "server-only": "./src/server-only.ts" },

  // Local development (`wrangler dev`, tests). Secrets go in .dev.vars (git-ignored).
  "vars": { "APP_ENV": "development" },
  "d1_databases": [
    { "binding": "DB", "database_name": "wildhearts-local", "database_id": "local-main", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "wildhearts-files-local" }],
  "durable_objects": { "bindings": [{ "name": "TOKEN_REFRESHER", "class_name": "TokenRefresher" }, { "name": "USER_LOCK", "class_name": "UserLock" }, { "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "workflows": [
    { "name": "wildhearts-sync-local", "binding": "SYNC_WORKFLOW", "class_name": "SyncSourceWorkflow" },
    { "name": "wildhearts-refresh-local", "binding": "REFRESH_WORKFLOW", "class_name": "RefreshSourcesWorkflow" },
    { "name": "wildhearts-directory-local", "binding": "DIRECTORY_WORKFLOW", "class_name": "DirectoryImportWorkflow" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenRefresher"] }, { "tag": "v2", "new_sqlite_classes": ["UserLock"] }, { "tag": "v3", "new_sqlite_classes": ["RateLimiter"] }],
  // Nightly refresh and directory import (src/index.ts, CRONS). `wrangler dev --test-scheduled` runs them locally.
  "triggers": { "crons": ["17 10 * * *", "41 8 * * *", "5 8 * * *"] },

  "env": {
    // Shared by every pull request's preview (one preview database, by decision).
    "preview": {
      "name": "wildhearts-api-preview",
      // EMAIL_LOG_LINKS: print sign-up and reset links to the logs until an email provider is
      // chosen. Preview data is made up; production never does this (src/auth/email.ts).
      "vars": { "APP_ENV": "preview", "EMAIL_LOG_LINKS": "true" },
      "d1_databases": [
        // database_id: set after `wrangler d1 create wildhearts-preview` (Phase 0).
        { "binding": "DB", "database_name": "wildhearts-preview", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      // The existing preview bucket's name (today's R2_BUCKET_NAME in Vercel's Preview scope).
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "wildhearts-files-preview" }],
      "durable_objects": { "bindings": [{ "name": "TOKEN_REFRESHER", "class_name": "TokenRefresher" }, { "name": "USER_LOCK", "class_name": "UserLock" }, { "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
      "workflows": [
        { "name": "wildhearts-sync-preview", "binding": "SYNC_WORKFLOW", "class_name": "SyncSourceWorkflow" },
        { "name": "wildhearts-refresh-preview", "binding": "REFRESH_WORKFLOW", "class_name": "RefreshSourcesWorkflow" },
        { "name": "wildhearts-directory-preview", "binding": "DIRECTORY_WORKFLOW", "class_name": "DirectoryImportWorkflow" }
      ],
      // Nightly refresh and directory import (src/index.ts, CRONS).
      "triggers": { "crons": ["17 10 * * *", "41 8 * * *", "5 8 * * *"] }
    },
    "production": {
      "name": "wildhearts-api-production",
      "vars": { "APP_ENV": "production" },
      "d1_databases": [
        // database_id: set after `wrangler d1 create wildhearts-prod` (Phase 0).
        { "binding": "DB", "database_name": "wildhearts-prod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      // The existing production bucket's name (today's R2_BUCKET_NAME in Vercel's Production scope).
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "wildhearts-files-production" }],
      "durable_objects": { "bindings": [{ "name": "TOKEN_REFRESHER", "class_name": "TokenRefresher" }, { "name": "USER_LOCK", "class_name": "UserLock" }, { "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
      "workflows": [
        { "name": "wildhearts-sync-production", "binding": "SYNC_WORKFLOW", "class_name": "SyncSourceWorkflow" },
        { "name": "wildhearts-refresh-production", "binding": "REFRESH_WORKFLOW", "class_name": "RefreshSourcesWorkflow" },
        { "name": "wildhearts-directory-production", "binding": "DIRECTORY_WORKFLOW", "class_name": "DirectoryImportWorkflow" }
      ],
      // Nightly refresh and directory import (src/index.ts, CRONS).
      "triggers": { "crons": ["17 10 * * *", "41 8 * * *", "5 8 * * *"] }
    },
    // Not deployed: only the copy tool (api/scripts/copy-to-d1.ts --target rehearsal) uses it, to
    // rehearse the Neon → D1 copy with production data in a database nothing serves. Create it for
    // a rehearsal (`wrangler d1 create wildhearts-rehearsal`) and delete it right after.
    "rehearsal": {
      "name": "wildhearts-api-rehearsal",
      "d1_databases": [
        { "binding": "DB", "database_name": "wildhearts-rehearsal", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ]
    }
  }
}
