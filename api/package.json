{
  "name": "@wild-hearts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle-chat.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply CHAT_DB --local --config wrangler.chat.jsonc"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.7.5",
    "better-call": "1.4.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "24.13.6",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
